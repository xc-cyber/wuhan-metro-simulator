@startuml
'==============================================================
' 武汉地铁模拟系统  用例图
' 画法遵循课本 1.3.1 节规范（图 1-8 / 图 1-9 风格）：
'   · 参与者用小人图形（火柴人）
'   · 用例用椭圆，写在系统边界矩形框内
'   · 参与者与用例之间用实线连接
'   · 用例名称竖着写在椭圆右侧
'==============================================================
left to right direction
skinparam shadowing false
skinparam defaultFontName "Microsoft YaHei"
skinparam monochrome true
skinparam usecaseFontSize 21
skinparam actorFontSize 23
skinparam nodesep 25
skinparam ranksep 40
skinparam usecase {
  BackgroundColor White
  BorderColor Black
  BorderThickness 1.2
}
skinparam actor {
  BackgroundColor White
  BorderColor Black
  BorderThickness 1.2
}
skinparam rectangle {
  BackgroundColor White
  BorderColor Black
  BorderThickness 1.5
}

title 武汉地铁模拟系统用例图

actor "乘客" as Passenger
actor "系统管理员" as Admin

rectangle "武汉地铁模拟系统" {
  usecase "查询线路站点信息" as UC1
  usecase "识别所有地铁中转站" as UC2
  usecase "查询附近站点" as UC3
  usecase "查询两站间所有路径" as UC4
  usecase "查询两站间最短路径" as UC5
  usecase "打印乘车方案" as UC6
  usecase "计算乘车票价" as UC7
  usecase "装载线路里程数据" as UC8
}

Passenger -- UC1
Passenger -- UC2
Passenger -- UC3
Passenger -- UC4
Passenger -- UC5
Passenger -- UC6
Passenger -- UC7
Admin -- UC8

@enduml
